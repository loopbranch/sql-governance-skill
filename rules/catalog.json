{
  "catalog_version": "2.0.0",
  "supported_dialects": ["mysql", "postgresql"],
  "load_order": {
    "mysql": ["common.json", "mysql.json"],
    "postgresql": ["common.json", "postgresql.json"]
  },
  "rules": {"common": "common.json", "mysql": "mysql.json", "postgresql": "postgresql.json"},
  "policy": {
    "unknown_dialect": "block-dialect-specific-conclusion",
    "mixed_dialects": "review-each-file-with-its-own-dialect",
    "structural_change_confirmation": true
  }
}
