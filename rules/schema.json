{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/loopbranch/sql-governance-skill/main/rules/schema.json",
  "title": "SQL governance dialect rule file",
  "type": "object",
  "required": ["schema_version", "dialect", "description", "rules"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "dialect": {"enum": ["common", "mysql", "postgresql"]},
    "description": {"type": "string", "minLength": 1},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "source", "name", "level", "gate", "scope", "dialects", "condition", "check", "examples", "remediation", "confirmation_required"],
      "properties": {
        "id": {"type": "string", "pattern": "^(G\\.[A-Z]+\\.[0-9]+|MYSQL-[A-Z]+-[0-9]{3}|POSTGRESQL-[A-Z]+-[0-9]{3})$"},
        "source": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "name": {"type": "string", "minLength": 1},
        "level": {"enum": ["prohibition", "mandatory", "recommendation", "reference"]},
        "gate": {"enum": ["block", "warn", "info"]},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "dialects": {"type": "array", "minItems": 1, "items": {"enum": ["mysql", "postgresql"]}},
        "condition": {"type": "string", "minLength": 1},
        "check": {
          "type": "object", "required": ["kind", "detector"],
          "properties": {"kind": {"enum": ["static", "manual", "hybrid"]}, "detector": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        },
        "examples": {
          "type": "object", "required": ["positive", "negative"],
          "properties": {"positive": {"type": "string", "minLength": 1}, "negative": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        },
        "remediation": {"type": "string", "minLength": 1},
        "confirmation_required": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
