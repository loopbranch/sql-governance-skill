{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/loopbranch/sql-governance-skill/main/rules/schema.json",
  "title": "SQL governance rule catalog",
  "type": "object",
  "required": ["catalog_version", "dialect", "rules"],
  "properties": {
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "dialect": {"type": "string"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "name", "level", "gate", "scope", "condition", "check", "examples", "remediation", "confirmation_required"],
        "properties": {
          "id": {"type": "string", "pattern": "^SQL-[A-Z]+-[0-9]{3}$"},
          "source": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "name": {"type": "string", "minLength": 1},
          "level": {"enum": ["prohibition", "mandatory", "recommendation", "reference"]},
          "gate": {"enum": ["block", "warn", "info"]},
          "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "condition": {"type": "string", "minLength": 1},
          "check": {
            "type": "object",
            "required": ["kind", "detector"],
            "properties": {
              "kind": {"enum": ["static", "manual", "hybrid"]},
              "detector": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "examples": {
            "type": "object",
            "required": ["positive", "negative"],
            "properties": {"positive": {"type": "string"}, "negative": {"type": "string"}},
            "additionalProperties": false
          },
          "remediation": {"type": "string", "minLength": 1},
          "confirmation_required": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
